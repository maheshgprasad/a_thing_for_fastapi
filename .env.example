# Copy to .env and fill in only the providers you use.
# The chat route reads provider from the JSON body. CHAT_PROVIDER is the default.

CHAT_PROVIDER=dictionary
REQUEST_TIMEOUT_SECONDS=60

# Optional. When set, /chat and /bot require Authorization: Bearer <key>.
# /health stays open.
APP_API_KEY=

# Local Ollama. Start it with `ollama serve` and pull a model first.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude. https://docs.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=1024

# IBM Bob inference. Create an Inference key at bob.ibm.com.
# General keys also need IBM_BOB_TEAM_ID, and sometimes IBM_BOB_INSTANCE_ID.
IBM_BOB_API_KEY=
IBM_BOB_BASE_URL=https://api.us-east.bob.ibm.com/inference/v1
IBM_BOB_MODEL=premium
IBM_BOB_AUTH_SCHEME=Apikey
IBM_BOB_INSTANCE_ID=
IBM_BOB_TEAM_ID=

# Cursor. Install with: python -m pip install "a-thing-for-fastapi[cursor]"
# Key: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_CWD=
